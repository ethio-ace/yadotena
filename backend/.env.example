DATABASE_URL=postgresql://user:password@localhost:5432/yadotena?sslmode=disable

REDIS_URL=redis://localhost:6379

JWT_SECRET=your-jwt-secret
JWT_EXPIRY=24h

APP_ENV=development
APP_PORT=8080

CORS_ALLOWED_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:3000

MIGRATIONS_DIR=migrations
SEEDS_DIR=seeds
RUN_SEEDS=true

UPLOADS_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# Ably Realtime
ABLY_API_KEY=
ABLY_APP_ID=

# Cloud NATS (Synadia NGS)
NATS_URL=tls://connect.ngs.global:4222
NATS_USER_JWT=
NATS_NKEY_SEED=

# Tigris Storage (S3 Compatible Storage)
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
STORAGE_BUCKET_NAME=yadotena
