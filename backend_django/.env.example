# Copy to .env for local development. In production set these as real
# environment variables on the server (systemd unit, Docker, panel, etc.).

# --- Required in production ---
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=semu.ethioace.com
# Frontend origin(s) that call the API from the browser (comma separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://semu.ethioace.com
# Rotate this key in the Ably dashboard: the old one was committed to git.
ABLY_API_KEY=

# --- Optional ---
# SQLITE_PATH=/var/lib/yadotena/db.sqlite3
# MEDIA_ROOT=/var/lib/yadotena/media
# SERVE_MEDIA=true                # false if nginx serves /media/ directly
# DJANGO_SECURE_SSL_REDIRECT=false # true if Django itself should redirect http->https
# API_TOKEN_TTL_HOURS=12           # keep in sync with the frontend session length
# THROTTLE_LOGIN=10/min
# THROTTLE_PUBLIC_ORDERS=60/min
# LOG_LEVEL=INFO

# Local development: uncomment
# DJANGO_DEBUG=true
