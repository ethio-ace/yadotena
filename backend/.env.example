# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Upstash Redis (use rediss:// for TLS — preferred by this API)
REDIS_URL=rediss://default:TOKEN@YOUR-ENDPOINT.upstash.io:6379

# Optional REST vars (not required by the Go API; keep if you use them elsewhere)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# Host
APP_ENV=development
APP_PORT=8080
# PORT=   # Render/Leapcell set this automatically

# Frontend — use * in development to allow any origin (see router corsAllowAll)
CORS_ALLOWED_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:3000

MIGRATIONS_DIR=migrations
SEEDS_DIR=seeds
# true once to bootstrap DB data; false after first seed
RUN_SEEDS=false
# DISABLE_RATE_LIMIT=true  # optional; development already skips rate limits

UPLOADS_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Cloudflare R2 (aliases accepted: R2_BUCKET_NAME, R2_PUBLIC_URL, R2_ENDPOINT)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
R2_ENDPOINT=
